{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "a.보도자료",
        "b.공지",
        "c.이벤트"
      ]
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "subTitle": {
      "type": "string"
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "tag": {
      "type": "component",
      "component": "news.tag",
      "repeatable": true
    }
  }
}
